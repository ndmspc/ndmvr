# # Copy to `.env.local` and fill in the values you need.
#
# Vite only exposes variables prefixed with VITE_ to the client bundle and
# resolves them at build time, so never put a secret in one of these.

# ============ Feature flags

# Allow duplicating the menu window into independent floating copies in
# the VR scene so multiple panels can stay open side by side. Default: false.
VITE_NDMVR_DUPLICATE_WINDOW_ENABLED="false"
